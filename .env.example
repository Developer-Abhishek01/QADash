# ============================================================
# QADash Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ----- GLOBAL -----
NODE_ENV=development

# ----- DATABASE (PostgreSQL) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=qadash
# Backend Prisma connection string (must match above)
DATABASE_URL=postgresql://postgres:postgres123@127.0.0.1:5432/qadash?schema=public

# ----- REDIS (for BullMQ queues) -----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0
REDIS_QUEUE_DB=1

# ----- JWT (CHANGE ALL SECRETS IN PRODUCTION) -----
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-string
JWT_RESET_SECRET=change-me-to-another-random-string
JWT_EXPIRES_IN=15m

# ----- API URLs -----
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
BACKEND_API_URL=http://localhost:3001
CORS_ORIGIN=http://127.0.0.1:3000

# ----- AI ENGINE (Python FastAPI, port 3002) -----
AI_ENGINE_URL=http://localhost:3002
AI_ENGINE_API_KEY=change-me-to-a-random-api-key
REDIS_URL=redis://:redis123@127.0.0.1:6379/0

# ----- AI PROVIDER (OpenAI-compatible) -----
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# ----- AI PROVIDER #2 (fallback, e.g. OpenRouter) -----
AI2_API_KEY=sk-or-your-openrouter-key-here
AI2_BASE_URL=https://openrouter.ai/api/v1
AI2_MODEL=openrouter/free
AI2_FALLBACK_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free

# ----- SEED (first-time admin user) -----
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=YourStr0ng!AdminPass

# ----- LOGGING -----
LOG_LEVEL=info
LOG_FORMAT=json

# ----- QUEUE WORKERS -----
QUEUE_CONCURRENCY_EXECUTION=5
QUEUE_CONCURRENCY_REPORT=3
QUEUE_CONCURRENCY_AI=2
QUEUE_CONCURRENCY_NOTIFICATION=10

# ----- APPIUM (mobile testing) -----
APPIUM_URL=http://127.0.0.1:4723

# ----- PERFORMANCE TESTING -----
K6_BIN=k6
K6_OUT_HTTP_API_URL=http://backend:3001/api/performance/metrics

# ----- SECURITY SCANNING -----
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=change-me-zap-key

# ----- MONITORING -----
GRAFANA_PASSWORD=admin123
ELASTIC_PASSWORD=elastic123
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# ----- AUTOMATION TESTS (E2E) -----
TEST_ADMIN_EMAIL=admin@yourcompany.com
TEST_ADMIN_PASSWORD=YourStr0ng!AdminPass
TEST_QA_EMAIL=qa@yourcompany.com
TEST_QA_PASSWORD=QAStr0ng!Pass
TEST_AUTOMATION_EMAIL=automation@yourcompany.com
TEST_AUTOMATION_PASSWORD=AutoStr0ng!Pass
TEST_DEV_EMAIL=dev@yourcompany.com
TEST_DEV_PASSWORD=DevStr0ng!Pass
TEST_MANAGER_EMAIL=manager@yourcompany.com
TEST_MANAGER_PASSWORD=MgrStr0ng!Pass
TEST_VIEWER_EMAIL=viewer@yourcompany.com
TEST_VIEWER_PASSWORD=ViewStr0ng!Pass
