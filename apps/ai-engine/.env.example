# LLM Configuration for AI-powered FRD/BRD parsing & test generation
# Set at least LLM_API_KEY or OPENAI_API_KEY for real AI features
# Without these, the AI Engine falls back to basic regex/template mode

# Primary: use any OpenAI-compatible API
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Alternative: use OpenAI directly (only if LLM_API_KEY not set)
# OPENAI_API_KEY=sk-your-openai-api-key
